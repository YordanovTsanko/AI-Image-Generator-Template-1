PORT=8080
MONGODB_URL=
CLOUDFLARE_API_TOKEN=

# По избор: ID на Cloudflare акаунта. Ако е празно, се открива автоматично от токена.
# Намира се в Cloudflare Dashboard → Workers AI → "Use REST API" (или в адреса dash.cloudflare.com/<ACCOUNT_ID>)
CLOUDFLARE_ACCOUNT_ID=

# По избор: модел за генериране. По подразбиране – FLUX.2 [klein] 9B (реалистични снимки).
# Други възможности:
#   @cf/black-forest-labs/flux-1-schnell  – най-евтин, повече снимки на ден от безплатния лимит
#   @cf/black-forest-labs/flux-2-dev      – най-реалистичен, но бавен и скъп
#   @cf/leonardo/lucid-origin             – Leonardo, добър реализъм
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# По избор: размер в пиксели (квадрат, 512–1536) и брой стъпки (не важи за flux-2-klein)
# CLOUDFLARE_IMAGE_SIZE=1024
# CLOUDFLARE_IMAGE_STEPS=