PORT=8080
MONGODB_URL=
CLOUDFLARE_API_TOKEN=

# По избор: ID на Cloudflare акаунта. Ако е празно, се открива автоматично от токена.
# Намира се в Cloudflare Dashboard → Workers AI → "Use REST API" (или в адреса dash.cloudflare.com/<ACCOUNT_ID>)
CLOUDFLARE_ACCOUNT_ID=

# По избор: модел за генериране (по подразбиране FLUX.1 schnell) и брой стъпки (1–8)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=8
